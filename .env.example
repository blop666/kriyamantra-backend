# Copy to .env.local and fill values. Never commit .env.local.

# App
META_GRAPH_API_VERSION=v25.0

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Postgres connection string. Use the pooler URL for serverless/Vercel.
DATABASE_URL=

# Xkiro AI (server-only; never use NEXT_PUBLIC_)
AI_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=
AI_MODEL=openai/gpt-5.6-sol
AI_VISION_MODEL=google/gemini-3.6-flash
AI_FALLBACK_MODEL=qwen/qwen3.7-plus:free
AI_IMAGE_MODEL=openai/gpt-image-2.5
AI_MAX_OUTPUT_TOKENS=1200
AI_REQUEST_TIMEOUT_MS=30000
AI_IMAGE_REQUEST_TIMEOUT_MS=120000
AI_CHATBOT_RATE_LIMIT=20
AI_ADMIN_DAILY_LIMIT=30

# Meta app
META_APP_ID=
META_APP_SECRET=

# Instagram
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_CONFIGURATION_ID=

# WhatsApp Cloud API
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Added later when the local webhook exists
WHATSAPP_WEBHOOK_URL=
INSTAGRAM_REDIRECT_URI=
# Generate a random 32+ byte secret. Never expose it to the browser.
INTEGRATION_ENCRYPTION_KEY=
